# === CRITICAL SECURITY VARIABLES (REQUIRED IN PRODUCTION) ===
# Generate strong secrets: openssl rand -base64 32
SESSION_SECRET=change_this_to_a_strong_random_string
JWT_SECRET=change_this_to_a_strong_random_string
JWT_REFRESH_SECRET=change_this_to_a_strong_random_string

# === ENVIRONMENT ===
NODE_ENV=development

# === DATABASE ===
MONGODB_URI=mongodb://localhost:27017/fleetpro
DATABASE_URL=mongodb://localhost:27017/fleetpro

# === API CONFIGURATION ===
VITE_API_URL=http://localhost:5050
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5050
COOKIE_DOMAIN=

# === EMAIL CONFIGURATION ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fleetpro.com

# === PAYMENT GATEWAY (OPTIONAL) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# === AWS/CLOUD STORAGE (OPTIONAL) ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# === LOGGING ===
LOG_LEVEL=info

# === PORT CONFIGURATION ===
PORT=5050
VITE_PORT=5173

# === REDIS (OPTIONAL - FOR CACHING) ===
REDIS_URL=redis://localhost:6379

# === TWILIO (OPTIONAL - FOR SMS) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === GOOGLE OAUTH (OPTIONAL) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === OTHER ===
ENABLE_HTTPS=false
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
