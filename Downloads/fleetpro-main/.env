# === CRITICAL SECURITY VARIABLES ===
# IMPORTANT: Change these values in production!
SESSION_SECRET=dev_session_secret_change_in_production_$(openssl rand -base64 16)
JWT_SECRET=dev_jwt_secret_change_in_production_$(openssl rand -base64 16)
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_$(openssl rand -base64 16)

# === DATABASE ===
MONGODB_URI=mongodb://localhost:27017/fleetpro
DATABASE_URL=mongodb://localhost:27017/fleetpro

# === ENVIRONMENT ===
NODE_ENV=development
PORT=5050

# === API CONFIGURATION ===
VITE_API_URL=http://localhost:5050
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5050
COOKIE_DOMAIN=

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
